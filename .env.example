# ==========================================
# 1. SERVER & APP CONFIG
# ==========================================
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
# Opsional: pisahkan dengan koma (jika kosong menggunakan daftar default)
CORS_ALLOWED_ORIGINS=""
AUTH_TRUSTED_ORIGINS=""
COOKIE_DOMAIN="kenantomfie.com"

# ==========================================
# 2. DATABASE (SUPABASE / POSTGRESQL)
# ==========================================
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ==========================================
# 3. AUTHENTICATION (BETTER AUTH & OAUTH)
# ==========================================
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"
JWT_SECRET="your_jwt_secret"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub OAuth & API (G1THUB_* agar tidak terkena reserved prefix Vercel/GitHub)
G1THUB_CLIENT_ID="your_github_client_id"
G1THUB_CLIENT_SECRET="your_github_client_secret"
G1THUB_TOKEN_API="your_github_personal_access_token"
G1THUB_RELEASES_OWNER="khensin166"
G1THUB_RELEASES_REPO="Kainest"

# ==========================================
# 4. AI SERVICES (GROQ, WHISPER, RECEIPT AI)
# ==========================================
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="qwen/qwen3.6-27b"
# Opsional: custom base URL untuk Groq proxy
# GROQ_BASE_URL=""

CLOUDFLARE_WHISPER_URL="https://kainest-ear.kenan2020oke.workers.dev"

RECEIPT_AI_URL="https://receipt-ai.kenantomfie.com"
RECEIPT_AI_TOKEN="your_receipt_ai_token"

# ==========================================
# 5. MEDIA & EMAIL (CLOUDINARY & RESEND)
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="noreply@mail.kenantomfie.site"

# ==========================================
# 6. WHATSAPP BOT (GOWA) & SHIFT SCHEDULER
# ==========================================
GOWA_BASE_URL="https://gowa.kenantomfie.com"
WA_BOT_API_KEY="your_gowa_basic_auth_base64"
GOWA_DEVICE_ID="your_gowa_device_uuid"
# Mode environment bot: "production" atau "staging"
BOT_ENV_MODE="staging"
# Whitelist nomor/JID di mode staging (dipisah koma)
STAGING_ALLOWED_NUMBERS=""

# Scheduler (set true hanya di instance utama agar tidak double-send)
ENABLE_SCHEDULER=true
GOOGLE_API_KEY_SPREADSHEET="your_google_sheets_api_key"
SPREADSHEET_ID="your_google_spreadsheet_id"
# Opsional: kirim reminder kegiatan harian ke Group JID WA (jika kosong fallback ke phone_number user)
SHIFT_REMINDER_TARGET_JID="120363421885675872@g.us"

# ==========================================
# 7. BINUS LMS ACADEMIC CALENDAR & REMINDER
# ==========================================
ACADEMIC_DATA_DIR="./data/academic"
ACADEMIC_EXCEL_DOWNLOAD_URL="https://your-sharepoint-download-url"
# Nomor WA pribadi (628xxx) atau Group JID (120363xxx@g.us)
ACADEMIC_REMINDER_TARGET_PHONE="120363431619904199@g.us"
ACADEMIC_SYNC_CRON="0 */6 * * *"
ACADEMIC_SYNC_BATCH_SIZE=30
ACADEMIC_ARCHIVE_RETENTION_DAYS=2
ACADEMIC_DB_RETENTION_DAYS=30
ACADEMIC_MUTE_WEEKLY_LECTURE=true

# ==========================================
# 8. OBSERVABILITY (GRAFANA LOKI)
# ==========================================
GRAFANA_LOKI_URL="https://user:token@logs-prod-xxx.grafana.net/loki/api/push"
