generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["kainest"]
}

model Couple {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  user1     User     @relation("User1Couple", fields: [user1Id], references: [id])
  user2     User     @relation("User2Couple", fields: [user2Id], references: [id])
  notes     Note[]   @relation("CoupleNotes")
  photos    Photo[]
  todos     Todo[]   @relation("CoupleTodos")
  @@schema("kainest")
}

model Photo {
  id         String   @id @default(uuid())
  imageUrl   String
  caption    String?
  coupleId   String?
  uploadedBy String
  createdAt  DateTime @default(now())
  couple     Couple?  @relation(fields: [coupleId], references: [id])
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  
  @@index([coupleId])
  @@schema("kainest")
}

model UserProfile {
  id             String   @id @default(uuid())
  displayName    String?
  avatarUrl      String?
  invitationCode String?  @unique
  createdAt      DateTime @default(now())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  @@schema("kainest")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  password     String?
  name         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime?         @updatedAt
  phone_number String?           @unique
  whatsappJid  String?           @unique // Untuk menampung @lid atau format JID unik lainnya
  couples1     Couple[]          @relation("User1Couple")
  couples2     Couple[]          @relation("User2Couple")
  notes        Note[]            @relation("UserNotes")
  logs         NotificationLog[]
  notifications AppNotification[]
  feedbacks     UserFeedback[]
  photos       Photo[]
  todos        Todo[]            @relation("UserTodos")
  profile      UserProfile?
  shifts       UserShift[]

  // --- NEW: BUDGETING FIELDS ---
  salary Int @default(0) // Gaji bulanan
  payday Int @default(31) // Tanggal gajian / reset siklus (1-31, nilai 31 = Akhir Bulan)

  // Relasi ke fitur Budgeting
  budgetCategories BudgetCategory[] // Kategori custom user
  monthlyHistories MonthlyFinancialHistory[] // Raport keuangan bulanan
  pockets          BudgetPocket[] // Template Kantong User
  transactions     Transaction[] // Catatan pengeluaran
  aiSuggestions    AISuggestion[] // Log saran AI
  emailVerified    Boolean          @default(false)
  image            String?
  sessions         Session[]
  accounts         Account[]
  waBotConfig      WaBotConfig?
  botActiveGroups  BotActiveGroup[]

  // --- NEW: ROLE & PERMISSIONS (Better Auth Admin Plugin) ---
  role        String?  @default("user")
  banned      Boolean? @default(false)
  banReason   String?
  banExpires  DateTime?
  permissions String[] @default(["budgeting"]) // Array of allowed modules (e.g. ["budgeting", "notes", "todos", "wabot"])

  // Relasi ke Split Bill Session
  splitBills  SplitBillSession[]

  // Relasi ke Log Penggunaan AI
  apiUsageLogs ApiUsageLog[]

  // --- Rencana Keuangan: tagihan, cicilan, dan wishlist tabungan ---
  recurringBills      RecurringBill[]
  billPayments        BillPayment[]
  savingGoals         SavingGoal[]
  savingContributions SavingContribution[]
  commitmentAlerts    CommitmentAlert[]
  pocketTemplates     PocketTemplate[]

  @@schema("kainest")
}

model UserShift {
  userId     String
  date       DateTime @db.Date
  shift_type String
  createdAt  DateTime @default(now())
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@schema("kainest")
}

model ShiftActivity {
  id            String            @id @default(uuid())
  shift_type    String
  activity_name String
  time_start    String
  reminder_time String
  note          String?
  logs          NotificationLog[]

  @@unique([shift_type, reminder_time])
  @@schema("kainest")
}

model NotificationLog {
  id         String        @id @default(uuid())
  userId     String
  activityId String
  sent_at    DateTime      @default(now())
  activity   ShiftActivity @relation(fields: [activityId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@unique([userId, activityId, sent_at])
  @@schema("kainest")
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM") // 'SYSTEM' | 'ALERT' | 'AI_INSIGHT'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, isRead, createdAt(sort: Desc)]) // Notifikasi lonceng header (unread sorted)
  @@schema("kainest")
}

model UserFeedback {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  rating    Int?     // 1-5, opsional
  isVisible Boolean  @default(true) // Admin bisa hide
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVisible])
  @@schema("kainest")
}

model SystemUpdate {
  id          String   @id @default(uuid())
  version     String   @unique // e.g. "v1.3.0"
  title       String
  description String   @db.Text
  date        DateTime // Tanggal rilis dari GitHub
  url         String?  // Link ke GitHub Release
  badge       String?  @default("Baru")
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
  @@schema("kainest")
}

model Todo {
  id           String   @id @default(uuid())
  title        String
  coupleId     String
  createdAt    DateTime @default(now())
  createdById  String
  description  String?
  is_completed Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  couple       Couple   @relation("CoupleTodos", fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("UserTodos", fields: [createdById], references: [id], onDelete: Cascade)
  
  @@index([coupleId])
  @@index([createdById])
  @@schema("kainest")
}

model Note {
  id                String         @id @default(uuid())
  title             String
  content           Json
  is_public         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  authorId          String
  coupleId          String?
  partnerPermission NotePermission @default(VIEWER)
  author            User           @relation("UserNotes", fields: [authorId], references: [id], onDelete: Cascade)
  couple            Couple?        @relation("CoupleNotes", fields: [coupleId], references: [id])
  
  @@index([authorId])
  @@index([coupleId])
  @@schema("kainest")
}

enum NotePermission {
  VIEWER
  EDITOR
  @@schema("kainest")
}

// ==========================================
// 💰 FITUR BUDGETING & AI (Kenin System)
// ==========================================

enum TransactionType {
  INCOME
  EXPENSE
  @@schema("kainest")
}

// 1. Kategori (Dinamis: Bisa default sistem, bisa custom user)

model BudgetCategory {
  id        String          @id @default(uuid())
  name      String // Contoh: "Makan", "Transport", "Kost"
  type      TransactionType @default(EXPENSE)
  icon      String? // Emoji atau url icon
  isDefault Boolean         @default(false) // True jika bawaan sistem
  createdAt DateTime        @default(now())

  // TAMBAHAN BARU UNTUK LLM
  keywords  String[]        @default([]) // Contoh: ["makan", "minum", "gofood"]

  userId String? // Nullable. Jika null = Kategori Global (semua user punya)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  pockets        BudgetPocket[] // Relasi ke BudgetPocket
  recurringBills RecurringBill[] // Tagihan yang memotong kantong kategori ini

  @@index([userId])
  @@index([isDefault])
  @@schema("kainest")
}

// 2. Raport Keuangan Bulanan (History)
model MonthlyFinancialHistory {
  id              String   @id @default(uuid())
  userId          String
  period          DateTime @db.Date // Tanggal 1 setiap bulan (contoh: 2026-05-01)
  
  // Snapshots (Fotokopi Gaji & Kondisi di bulan tersebut)
  salarySnapshot  Int      // Gaji pada bulan ini
  
  // Agregasi Totals
  totalBudgeted   Int      // Total nilai uang yang dialokasikan ke kantong
  totalSaved      Int      // Total nilai uang yang dialokasikan khusus ke "Tabungan"
  totalSpent      Int      @default(0) // Total pengeluaran bulan ini
  totalIncome     Int      @default(0) // Total pemasukan tambahan bulan ini (di luar gaji)
  
  // Rincian Kantong (Disimpan sebagai teks JSON)
  pocketsSnapshot Json     
  
  // Ruang untuk AI di masa depan
  aiEvaluation    String?  @db.Text

  /// Snapshot komitmen (tagihan & wishlist) pada siklus ini.
  /// Nullable agar baris riwayat lama tetap valid tanpa backfill.
  commitmentsSnapshot Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, period]) // Hanya boleh 1 raport per user per bulan
  @@index([userId, period(sort: Desc)]) // Mempercepat sorting riwayat bulanan
  @@schema("kainest")
}

// 2.5 Kantong Budget (Template Limit/Persentase Permanen User)
model BudgetPocket {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  
  percentage  Float?   // Persentase alokasi dari total gaji (misal: 15)
  limitAmount Float?   // Atau nominal pasti jika tidak ingin persen (misal: 500000)
  keywords    String[] @default([]) // Kata kunci spesifik kantong
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1 user hanya punya 1 pocket per kategori
  @@unique([userId, categoryId]) 
  @@schema("kainest")
}

// 3. Transaksi Harian

model Transaction {
  id     String          @id @default(uuid())
  amount Int
  note   String?
  date   DateTime        // Tanggal transaksi terjadi
  type   TransactionType @default(EXPENSE) // INCOME atau EXPENSE (data lama = EXPENSE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Terisi bila transaksi ini lahir dari pelunasan sebuah tagihan.
  billPayment BillPayment?

  @@index([userId, date])
  @@index([userId, type])                      // Filter tipe (INCOME/EXPENSE)
  @@index([userId, type, date(sort: Desc)])    // Pagination semua transaksi + filter tipe
  @@index([userId, categoryId, date])          // Agregasi pengeluaran per kantong
  @@index([categoryId])
  @@schema("kainest")
}


model WaBotConfig {
  id                    String   @id @default(uuid())
  // Field di code: userId, Kolom di DB: user_id
  userId                String   @unique @map("user_id")
  // Field di code: baseUrl, Kolom di DB: base_url
  baseUrl               String   @map("base_url")
  // Field di code: adminSecret, Kolom di DB: admin_secret
  adminSecret           String?  @map("admin_secret")
  // Nomor WA Bot Production
  botPhoneNumber        String?  @map("bot_phone_number")
  // Nomor WA Bot Staging (Terpisah agar tidak saling overwrite)
  botPhoneNumberStaging String?  @map("bot_phone_number_staging")
  // Mapping timestamp juga penting
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relasi ke User
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("kainest")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@schema("kainest")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@schema("kainest")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("kainest")
}

// ==========================================
// 🤖 WHATSAPP BOT SYSTEM
// ==========================================

model BotActiveGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  groupId   String   @unique
  userId    String?  // User pertama yg terkait grup ini (auto-relink)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([userId])
  @@schema("kainest")
}

model BackupTargets {
  id         String   @id @default(uuid())
  session_id String
  chat_id    String
  name       String?
  createdAt  DateTime @default(now())

  ChatLogs ChatLogs[]

  @@unique([session_id, chat_id])
  @@index([chat_id])
  @@schema("kainest")
}

model ChatLogs {
  id              String        @id @default(uuid())
  session_id      String
  chat_id         String
  sender          String
  message_content String        @db.Text
  message_type    String        @default("conversation")
  timestamp       DateTime
  raw_data        Json?
  createdAt       DateTime      @default(now())

  BackupTarget BackupTargets @relation(fields: [chat_id, session_id], references: [chat_id, session_id])

  @@index([chat_id, session_id])
  @@index([timestamp(sort: Desc)])
  @@schema("kainest")
}

model ApiKeys {
  id         String   @id @default(uuid())
  name       String
  key        String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@schema("kainest")
}

// ==========================================
// 🧾 SPLIT BILL SYSTEM
// ==========================================

model SplitBillSession {
  id              String   @id @default(uuid())
  userId          String   // Siapa yang membuat split bill ini
  receiptImage    String?  // (Opsional) URL gambar struk yang diupload
  merchant        String?  // Nama tempat makan
  
  // Data hitungan dari Receipt AI (Disimpan sebagai JSON agar fleksibel)
  totalAmount     Int
  splitData       Json     // Menyimpan JSON detail per orang, subtotal, tax, dll
  summaryText     String   @db.Text // Teks mentah siap blast WA
  
  isPublic        Boolean  @default(true) // Apakah bisa diakses dari web publik
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)]) // Riwayat split bill user terbaru
  @@schema("kainest")
}

// ==========================================
// 🤖 AI USAGE TRACKING
// ==========================================

model ApiUsageLog {
  id               String   @id @default(uuid())
  userId           String?  // Null jika request tidak berhasil dikaitkan ke user
  feature          String   // Misal: "bot_transaction", "ai_suggestion"
  modelUsed        String   // Misal: "qwen/qwen3.6-27b", "openai/gpt-oss-120b"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("kainest")
}

// ==========================================
// 🧠 AI BUDGET SUGGESTION
// ==========================================

model AISuggestion {
  id              String    @id @default(uuid())
  userId          String

  // ── Kolom LAMA (kompatibel dengan EvaluateMonthlyBudgetUseCase & GetAiAdvisorUseCase) ──
  type            String    // "MONTHLY_EVAL" | "DAILY_ADVISOR" | "MONTHLY_RESET"
  suggestion_text String    @db.Text // JSON string (untuk MONTHLY_EVAL) atau teks biasa (DAILY_ADVISOR)
  is_approved     Boolean   @default(false)

  // ── Kolom BARU (untuk fitur Monthly Reset & 1-Click Apply) ──
  period          String?   // "YYYY-MM-01" — siklus yang baru selesai (hanya untuk MONTHLY_RESET)
  proposed_pockets Json?    // Array of { categoryId, categoryName, newLimitAmount, reason }
  applied_at      DateTime? // Kapan user meng-apply suggestion ini

  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, period]) // Query suggestion terbaru per siklus payday
  @@schema("kainest")
}


// ==========================================
// 📅 RENCANA KEUANGAN — Tagihan, Cicilan & Wishlist Tabungan
// Rancangan lengkap: doc/rencana_tabungan_tagihan.md
//
// Asimetri yang dipegang di seluruh fitur ini:
// tagihan MENGHASILKAN Transaction (konsumsi), tabungan TIDAK (pemindahan).
// Keduanya sama-sama memotong budget, tapi hanya satu yang boleh muncul di
// totalSpent dan grafik tren pengeluaran.
// ==========================================

enum BillFrequency {
  MONTHLY
  WEEKLY
  YEARLY
  ONE_TIME
  @@schema("kainest")
}

enum BillStatus {
  ACTIVE
  COMPLETED // tenor cicilan habis; berhenti menagih sendiri
  ARCHIVED
  @@schema("kainest")
}

enum BillPaymentStatus {
  PAID
  SKIPPED
  @@schema("kainest")
}

enum SavingGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
  @@schema("kainest")
}

enum ContributionSource {
  AUTO_CYCLE // dibuat cron di awal siklus dari monthlyAllocation
  MANUAL     // disetor sadar oleh pengguna
  WITHDRAWAL // penarikan (amount negatif)
  @@schema("kainest")
}

enum CommitmentZone {
  SAFE
  WARNING
  DANGER
  @@schema("kainest")
}

/// Tagihan berulang & cicilan bertenor.
/// Tidak ada pencatatan otomatis: pengeluaran hanya tercatat bila pengguna
/// mengonfirmasi pembayaran.
model RecurringBill {
  id         String @id @default(uuid())
  userId     String
  categoryId String
  name       String
  amount     Int // perkiraan; boleh dikoreksi saat melunasi

  frequency BillFrequency @default(MONTHLY)
  dueDay    Int // 1-31, diisi pengguna
  dueMonth  Int? // 1-12, hanya dipakai saat frequency = YEARLY
  startDate DateTime      @db.Date

  /// Tenor cicilan. null = berulang tanpa akhir (kos, listrik, langganan).
  totalInstallments Int?
  /// Bertambah setiap BillPayment berstatus PAID. Mencapai tenor -> COMPLETED.
  paidInstallments  Int  @default(0)

  reminderDaysBefore Int        @default(3)
  status             BillStatus @default(ACTIVE)
  note               String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payments BillPayment[]

  @@index([userId, status])
  @@index([userId, dueDay])
  @@index([categoryId])
  @@schema("kainest")
}

/// Satu baris per tagihan per siklus. Mencegah tagihan yang sama lunas dua kali.
model BillPayment {
  id     String   @id @default(uuid())
  billId String
  userId String
  /// Kunci siklus, memakai konvensi yang sama dengan MonthlyFinancialHistory.period
  /// (tanggal 1 bulan cycleEnd), dihitung lewat utils/cycleBoundaries.ts.
  period DateTime @db.Date

  status        BillPaymentStatus @default(PAID)
  installmentNo Int? // angsuran ke-berapa; null bila tagihan tanpa tenor
  paidAmount    Int? // null bila SKIPPED
  transactionId String?           @unique // null bila SKIPPED
  paidAt        DateTime          @default(now())

  bill        RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, period])
  @@index([userId, period])
  @@schema("kainest")
}

/// Wishlist tabungan. BUKAN BudgetPocket — pocket dibatasi @@unique([userId, categoryId])
/// sehingga pengguna hanya akan bisa punya satu target seumur hidup.
model SavingGoal {
  id                String    @id @default(uuid())
  userId            String
  name              String // "Jalan ke Bali"
  targetAmount      Int // 10_000_000
  monthlyAllocation Int       @default(0) // memotong budget siklus berjalan
  targetDate        DateTime? @db.Date
  icon              String? // emoji, mis. "🏝️"

  status    SavingGoalStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingContribution[]

  @@index([userId, status])
  @@schema("kainest")
}

/// Setoran tabungan. Nominal negatif = penarikan, supaya riwayatnya jujur
/// alih-alih menghapus baris lama.
model SavingContribution {
  id     String @id @default(uuid())
  goalId String
  userId String

  amount Int
  source ContributionSource @default(MANUAL)
  note   String?
  date   DateTime
  period DateTime           @db.Date

  createdAt DateTime @default(now())

  goal SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Setoran otomatis hanya boleh sekali per siklus per wishlist. Pengaman ini
  /// menahan cron yang terpanggil dua kali (restart container, jam tumpang tindih)
  /// dari menggandakan setoran.
  @@unique([goalId, period, source])
  @@index([userId, period])
  @@index([goalId, date])
  @@schema("kainest")
}

/// Penjaga anti-spam peringatan solvabilitas: satu peringatan per zona per siklus.
/// Tanpa ini, cron harian mengirim peringatan merah yang sama tiap pagi sampai
/// botnya dibisukan pengguna.
model CommitmentAlert {
  id        String         @id @default(uuid())
  userId    String
  period    DateTime       @db.Date
  zone      CommitmentZone
  shortfall Int            @default(0) // seberapa kurang saat DANGER
  sentAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, zone])
  @@index([userId, period])
  @@schema("kainest")
}

/// Template susunan kantong buatan pengguna. Menyatu dengan "Blueprint Cepat"
/// bawaan di frontend: blueprint = template sistem yang tak bisa dihapus,
/// baris di tabel ini = template pengguna. Satu daftar, satu cara pakai.
model PocketTemplate {
  id     String @id @default(uuid())
  userId String
  name   String // nama custom, mis. "Bulan Ramadan"
  /// [{ categoryId, limitType, percentage, limitAmount, keywords }]
  pockets Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@schema("kainest")
}
